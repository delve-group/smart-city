# Copy to .env in the repository root. Never commit real credentials.
# Choose separate passwords of at least 12 characters for the fictional accounts.
POSTGRES_PASSWORD=
DEMO_OFFICIAL_PASSWORD=
DEMO_ELECTRICITY_PASSWORD=
DEMO_WATER_PASSWORD=

# Must match the browser's origin. Production requires HTTPS behind a proxy.
APP_ORIGIN=http://localhost:3000
APP_PORT=3000

# Optional Scaleway deployment backup directory, outside this repository.
# Defaults to /var/backups/mradar. Used by npm run deploy and deploy:backup.
# MRADAR_BACKUP_DIR=/var/backups/mradar

# Optional durable worker timing. Heartbeat must be below one third of the lease.
# WORKER_POLL_MS=1000
# WORKER_LEASE_MS=30000
# WORKER_HEARTBEAT_MS=5000

# ElevenLabs and Qdrant credentials are not needed for this foundation.
