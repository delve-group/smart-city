# Copy to .env in the repository root. Never commit real credentials.
# Choose separate passwords of at least 12 characters for the fictional accounts.
POSTGRES_PASSWORD=
DEMO_OFFICIAL_PASSWORD=
DEMO_ELECTRICITY_PASSWORD=
DEMO_WATER_PASSWORD=

# Must match the browser's origin. Production requires HTTPS behind a proxy.
APP_ORIGIN=http://localhost:3000
APP_PORT=3000

# Demo mode: staff pages skip sign-in and act as the seeded demo accounts
# (official; electricity for the institution inbox). Never enable with real data.
# DEMO_MODE=true

# Optional Scaleway deployment backup directory, outside this repository.
# Defaults to /var/backups/mradar. Used by npm run deploy and deploy:backup.
# MRADAR_BACKUP_DIR=/var/backups/mradar

# Optional durable worker timing. Heartbeat must be below one third of the lease.
# WORKER_POLL_MS=1000
# WORKER_LEASE_MS=30000
# WORKER_HEARTBEAT_MS=5000

# Optional automated assessment. disabled keeps the labelled rule-based demo proposer.
DECISION_PROVIDER=disabled
# Required only for DECISION_PROVIDER=scaleway; passed to the worker, never the browser.
SCW_PROJECT_ID=
SCW_GENERATIVE_API_KEY=
SCW_DECISION_MODEL=qwen3.6-35b-a3b
# Private Qdrant and local embeddings require no provider credentials.
# Letters, digits, underscores and hyphens only; starts with a letter/digit, at most 64 characters.
# QDRANT_COLLECTION=mradar_records_v1
# Compose fixes QDRANT_URL=http://qdrant:6333 and
# SEARCH_MODEL_CACHE_DIR=/home/node/.cache/mradar-models (a shared persistent volume).
# For direct host search configuration, use apps/frontend/.env.local instead.

# Optional trusted-server MCP credentials. Unset roles are disabled; core startup is unaffected.
# Generate independent 32-byte random base64url tokens; never reuse account/provider secrets.
# MCP_DECISION_TOKEN=
# MCP_ELECTRICITY_TOKEN=
# MCP_WATER_TOKEN=
# MCP_TOKEN_EXPIRES_AT=2026-11-02T23:59:59Z
# Endpoint/client setup and rotation: apps/frontend/src/server/mcp/README.md
